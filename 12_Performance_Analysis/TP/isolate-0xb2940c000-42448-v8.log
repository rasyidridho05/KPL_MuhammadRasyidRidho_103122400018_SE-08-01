ource map.\n * @returns {string} The code with the source map attached.\n */\nfunction addSourceMap(code\x2C sourceMap) {\n  // The base64 encoding should be https://datatracker.ietf.org/doc/html/rfc4648#section-4\x2C\n  // not base64url https://datatracker.ietf.org/doc/html/rfc4648#section-5. See data url\n  // spec https://tools.ietf.org/html/rfc2397#section-2.\n  const base64SourceMap = Buffer.from(sourceMap).toString('base64');\n  return `${code}\\n\\n//# sourceMappingURL=data:application/json;base64\x2C${base64SourceMap}`;\n}\n\nmodule.exports = {\n  stripTypeScriptModuleTypes\x2C\n  stripTypeScriptTypes\x2C\n};\n
