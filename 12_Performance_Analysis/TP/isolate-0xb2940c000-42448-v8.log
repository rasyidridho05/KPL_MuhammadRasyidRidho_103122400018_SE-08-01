TypedArray'\x2C\n      'load'\x2C\n      'source'\x2C\n      source\x2C\n    );\n  }\n}\n\nfunction validateSourcePermissive(url\x2C context\x2C result) {\n  const { source\x2C format } = result;\n  if (format === 'commonjs' && source == null) {\n    // Accommodate the quirk in defaultLoad used by asynchronous loader hooks\n    // which sets source to null for commonjs.\n    // See: https://github.com/nodejs/node/issues/57327#issuecomment-2701382020\n    return;\n  }\n  validateSourceStrict(url\x2C context\x2C result);\n}\n\nfunction validateFormat(url\x2C context\x2C result) {\n  const { format } = result;\n  if (typeof format !== 'string' && format !== undefined) {\n    throw new ERR_INVALID_RETURN_PROPERTY_VALUE(\n      'a string'\x2C\n      'load'\x2C\n      'format'\x2C\n      format\x2C\n    );\n  }\n}\n\nclass ModuleResolveContext {\n  /**\n   * Context for the resolve hook.\n   * @param {string|undefined} parentURL Parent URL.\n   * @param {ImportAttributes|undefined} importAttributes Import attributes.\n   * @param {string[]} conditions Conditions.\n   */\n  constructor(parentURL\x2C importAttributes\x2C conditions) {\n    this.parentURL = parentURL;\n    this.importAttributes = importAttributes;\n    this.conditions = conditions;\n    // TODO(joyeecheung): a field to differentiate between require and import?\n  }\n};\n\nclass ModuleLoadContext {\n  /**\n   * Context for the load hook.\n   * @param {string|undefined} format URL.\n   * @param {ImportAttributes|undefined} importAttributes Import attributes.\n   * @param {string[]} conditions Conditions.\n   */\n  constructor(format\x2C importAttributes\x2C conditions) {\n    this.format = format;\n    this.importAttributes = importAttributes;\n    this.conditions = conditions;\n  }\n};\n\nlet decoder;\n/**\n * Load module source for a url\x2C through a hooks chain if it exists.\n * @param {string} url\n * @param {string|undefined} originalFormat\n * @param {ImportAttributes|undefined} importAttributes\n * @param {string[]} conditions\n * @param {(url: string\x2C context: ModuleLoadContext) => ModuleLoadResult} defaultLoad\n * @param {(url: string\x2C context: ModuleLoadContext\x2C result: ModuleLoadResult) => ModuleLoadResult} validateLoad\n * @returns {ModuleLoadResult}\n */\nfunction loadWithHooks(url\x2C originalFormat\x2C importAttributes\x2C conditions\x2C defaultLoad\x2C validateLoad) {\n  debug('loadWithHooks'\x2C url\x2C originalFormat);\n  const context = new ModuleLoadContext(originalFormat\x2C importAttributes\x2C conditions);\n  if (loadHooks.length === 0) {\n    return defaultLoad(url\x2C context);\n  }\n\n  const runner = buildHooks(loadHooks\x2C 'load'\x2C defaultLoad\x2C validateLoad\x2C context);\n\n  const result = runner(url\x2C context);\n  const { source\x2C format } = result;\n  if (!isAnyArrayBuffer(source) && !isArrayBufferView(source)) {\n    return result;\n  }\n\n  switch (format) {\n    // Text formats:\n    case undefined:\n    case 'module':\n    case 'commonjs':\n    case 'json':\n    case 'module-typescript':\n    case 'commonjs-typescript':\n    case 'typescript': {\n      decoder ??= new (require('internal/encoding').TextDecoder)();\n      result.source = decoder.decode(source);\n      break;\n    }\n    default:\n      break;\n  }\n  return result;\n}\n\n/**\n * Resolve module request to a url\x2C through a hooks chain if it exists.\n * @param {string} specifier\n * @param {string|undefined} parentURL\n * @param {ImportAttributes|undefined} importAttributes\n * @param {string[]} conditions\n * @param {(specifier: string\x2C context: ModuleResolveContext) => ModuleResolveResult} defaultResolve\n * @returns {ModuleResolveResult}\n */\nfunction resolveWithHooks(specifier\x2C parentURL\x2C importAttributes\x2C conditions\x2C defaultResolve) {\n  debug('resolveWithHooks'\x2C specifier\x2C parentURL\x2C importAttributes);\n  const context = new ModuleResolveContext(parentURL\x2C importAttributes\x2C conditions);\n  if (resolveHooks.length === 0) {\n    return defaultResolve(specifier\x2C context);\n  }\n\n  const runner = buildHooks(resolveHooks\x2C 'resolve'\x2C defaultResolve\x2C validateResolve\x2C context);\n\n  return runner(specifier\x2C context);\n}\n\nmodule.exports = {\n  convertCJSFilenameToURL\x2C\n  convertURLToCJSFilename\x2C\n  loadHooks\x2C\n  loadWithHooks\x2C\n  registerHooks\x2C\n  resolveHooks\x2C\n  resolveWithHooks\x2C\n  validateLoadStrict\x2C\n  validateLoadSloppy\x2C\n};\n
