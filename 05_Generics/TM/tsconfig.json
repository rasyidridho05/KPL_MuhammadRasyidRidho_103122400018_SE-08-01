{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2015","DOM"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
   "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["./**/*.js"]
}
